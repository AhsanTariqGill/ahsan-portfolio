---
import Base from '../layouts/Base.astro';
import { courseGroups, developmentAreas } from '../data/foundations';
import { site } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Foundations — Ahsan Tariq',
  url: `${site.url}/foundations`,
  description:
    'B.Sc. Computer Science coursework at UET Lahore (Narowal Campus), grouped by area, with the projects where each area is used.',
  author: { '@type': 'Person', name: site.name, url: site.url },
};
---

<Base
  title="Foundations — coursework by area | Ahsan Tariq"
  description="B.Sc. Computer Science coursework at UET Lahore (Narowal Campus), grouped by area, with the projects where each area is used. Overall CGPA 3.734 / 4.00."
  jsonLd={jsonLd}
>
  <div class="container page-head">
    <p class="eyebrow">Foundations</p>
    <h1>Coursework, grouped by area.</h1>
    <p class="lede">
      B.Sc. Computer Science at UET Lahore (Narowal Campus), session 2020 to 2024. Course names
      only — no individual grades. Overall CGPA 3.734 / 4.00.
    </p>
  </div>

  <section class="container section--tight">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Area</th>
            <th scope="col">Courses</th>
            <th scope="col">Where it shows up</th>
          </tr>
        </thead>
        <tbody>
          {courseGroups.map((group) => (
            <tr>
              <td><strong>{group.area}</strong></td>
              <td>{group.courses.join(', ')}</td>
              <td>{group.application ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <p class="eyebrow eyebrow--plain">Next</p>
        <h2>Areas I want to develop</h2>
      </div>
    </div>
    <div class="prose">
      <p>
        My practical experience is strongest in the layer that makes AI output usable: pipelines,
        review steps and audit trails. These are the areas I want to strengthen through the
        programme.
      </p>
      <ul>
        {developmentAreas.map((area) => <li>{area}</li>)}
      </ul>
      <p>
        <a href="/work">See the case studies →</a>
      </p>
    </div>
  </section>
</Base>
