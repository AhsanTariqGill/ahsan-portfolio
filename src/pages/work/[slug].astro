---
import Base from '../../layouts/Base.astro';
import { visibleProjects, projectNeighbours } from '../../data/projects';
import { inline } from '../../lib/text';
import { site } from '../../data/site';

export function getStaticPaths() {
  return visibleProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const neighbours = projectNeighbours(project.slug);
const canonical = `${site.url}/work/${project.slug}`;

let sectionNumber = project.sections.length;
const nextNumber = () => String(++sectionNumber).padStart(2, '0');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: `${project.name} — ${project.tagline}`,
    description: project.seoDescription,
    url: canonical,
    image: `${site.url}/og/${project.slug}.png`,
    author: { '@type': 'Person', name: site.name, url: site.url },
    about: project.name,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work` },
      { '@type': 'ListItem', position: 3, name: project.name, item: canonical },
    ],
  },
];
---

<Base
  title={project.seoTitle}
  description={project.seoDescription}
  ogType="article"
  ogImage={`/og/${project.slug}.png`}
  jsonLd={jsonLd}
>
  <article class="container case">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/work">Work</a> <span aria-hidden="true">/</span> <span>{project.name}</span>
    </nav>

    <header class="case__head">
      <p class="eyebrow">{project.kicker}</p>
      <h1 class="case__title">{project.name}</h1>
      <p class="case__tagline">{project.tagline}</p>
      <p class="lede" style="margin-top: 1.3rem">{project.summary}</p>
      <p class="case__delivered mono muted">
        Delivered via <a href={site.companyUrl} rel="noopener">{site.company}</a>.
      </p>
    </header>

    <div class="case__body">
      <aside class="case__aside" aria-label="Project facts">
        <dl class="aside-block" style="margin: 0">
          <dt>Role</dt>
          <dd>{project.role}</dd>
        </dl>
        <dl class="aside-block" style="margin: 0">
          <dt>Scope</dt>
          <dd set:html={inline(project.scope)} />
        </dl>
        <dl class="aside-block" style="margin: 0">
          <dt>Stack</dt>
          <dd>{project.stack.join(' · ')}</dd>
        </dl>
        {project.external && (
          <dl class="aside-block" style="margin: 0">
            <dt>Site</dt>
            <dd>
              <a href={project.external.href} rel="noopener">{project.external.label} ↗</a>
            </dd>
          </dl>
        )}
      </aside>

      <div class="case__main">
        {project.sections.map((section, i) => (
          <section class="case-section" id={`s${i + 1}`}>
            <span class="case-section__label">{String(i + 1).padStart(2, '0')}</span>
            <h2>{section.title}</h2>
            {section.paragraphs?.map((paragraph) => <p set:html={inline(paragraph)} />)}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li set:html={inline(bullet)} />)}
              </ul>
            )}
          </section>
        ))}

        {project.whatIDid && (
          <section class="case-section">
            <span class="case-section__label">{nextNumber()}</span>
            <h2>What I did</h2>
            <ul>
              {project.whatIDid.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )}

        {project.skills && (
          <section class="case-section">
            <span class="case-section__label">{nextNumber()}</span>
            <h2>Skills used</h2>
            <p>{project.skills}</p>
          </section>
        )}

        {project.decisions && project.decisions.length > 0 && (
          <section class="case-section">
            <span class="case-section__label">{nextNumber()}</span>
            <h2>Key technical decisions</h2>
            <ul class="decisions">
              {project.decisions.map((decision) => (
                <li class="decision">
                  <h3>{decision.title}</h3>
                  <p set:html={inline(decision.body)} />
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    <nav class="case-nav" aria-label="More projects">
      <a href={`/work/${neighbours.previous.slug}`}>
        <span>Previous</span>
        <strong>{neighbours.previous.name}</strong>
      </a>
      <a href={`/work/${neighbours.next.slug}`}>
        <span>Next</span>
        <strong>{neighbours.next.name}</strong>
      </a>
    </nav>
  </article>
</Base>
