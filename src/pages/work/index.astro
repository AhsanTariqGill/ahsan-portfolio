---
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Case studies — Ahsan Tariq',
    url: `${site.url}/work`,
    description:
      'Backend case studies across payments, marketplaces, grants discovery, warehouse operations and legal tech.',
    author: { '@type': 'Person', name: site.name, url: site.url },
    hasPart: projects.map((project) => ({
      '@type': 'Article',
      name: `${project.name} — ${project.tagline}`,
      url: `${site.url}/work/${project.slug}`,
    })),
  },
];
---

<Base
  title="Case studies — Ahsan Tariq, backend engineer"
  description="Five production systems across payments, marketplaces, grants discovery, warehouse operations and legal tech — written around the engineering decisions rather than feature lists."
  jsonLd={jsonLd}
>
  <div class="container page-head">
    <p class="eyebrow">Work</p>
    <h1>Five systems, four industries, one theme.</h1>
    <p class="lede">
      Every project below broke in the same place: the data layer. A booking that could be sold
      twice, a search index that drifted, an inventory number nobody could explain. Each case study
      covers the context, my role, the decisions I would defend, and what I measured.
    </p>
  </div>

  <section class="container section--tight">
    <div class="cards">
      {projects.map((project) => (
        <article class="card">
          <a class="card__link" href={`/work/${project.slug}`}>
            <p class="card__kicker">
              {project.index} · {project.kicker}
              {project.current && <span class="badge">Current</span>}
            </p>
            <h2 class="card__title">{project.name}</h2>
            <p class="card__text">{project.tagline}</p>
            <div class="work-item__stack" style="justify-content: flex-start; margin-top: 1rem">
              {project.cardStack.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <p class="card__foot mono">Read case study →</p>
          </a>
        </article>
      ))}
    </div>
  </section>
</Base>
