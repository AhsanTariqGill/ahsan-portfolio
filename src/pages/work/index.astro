---
import Base from '../../layouts/Base.astro';
import { visibleProjects } from '../../data/projects';
import { site } from '../../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Case studies — Ahsan Tariq',
    url: `${site.url}/work`,
    description:
      'Projects covering legal technology, marketplaces, grants discovery and golf operations.',
    author: { '@type': 'Person', name: site.name, url: site.url },
    hasPart: visibleProjects.map((project) => ({
      '@type': 'Article',
      name: `${project.name} — ${project.tagline}`,
      url: `${site.url}/work/${project.slug}`,
    })),
  },
];
---

<Base
  title="Case studies — Ahsan Tariq"
  description="Projects covering legal technology, marketplaces, grants discovery and golf operations. Each explains the problem, my role and key technical decisions."
  jsonLd={jsonLd}
>
  <div class="container page-head">
    <p class="eyebrow">Work</p>
    <h1>Selected projects</h1>
    <p class="lede">
      Projects covering legal technology, marketplaces, grants discovery and golf operations. Each
      explains the problem, my role and key technical decisions.
    </p>
  </div>

  <section class="container section--tight">
    <div class="cards">
      {visibleProjects.map((project) => (
        <article class="card">
          <a class="card__link" href={`/work/${project.slug}`}>
            <p class="card__kicker">
              {project.index} · {project.kicker}
              {project.current && <span class="badge">Current</span>}
            </p>
            <h2 class="card__title">{project.name}</h2>
            <p class="card__text">{project.tagline}</p>
            <div class="work-item__stack" style="justify-content: flex-start; margin-top: 1rem">
              {project.cardStack.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <p class="card__foot mono">Read case study →</p>
          </a>
        </article>
      ))}
    </div>
  </section>
</Base>
