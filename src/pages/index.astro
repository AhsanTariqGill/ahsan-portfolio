---
import Base from '../layouts/Base.astro';
import { visibleProjects } from '../data/projects';
import { site } from '../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.url,
    jobTitle: 'Team Lead',
    image: `${site.url}/ahsan-tariq.jpg`,
    worksFor: { '@type': 'Organization', name: site.company, url: site.companyUrl },
    alumniOf: { '@type': 'CollegeOrUniversity', name: site.education.institution },
    award: `${site.award.text}, ${site.award.date}`,
    address: { '@type': 'PostalAddress', addressLocality: 'Lahore', addressCountry: 'PK' },
    description: site.description,
    email: `mailto:${site.email}`,
    sameAs: [site.github, site.linkedin],
    knowsAbout: [
      'Backend engineering',
      'Data modelling',
      'PostgreSQL',
      'Query optimisation',
      'Elasticsearch',
      'Algolia',
      'Python',
      'FastAPI',
      'Data pipelines',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${site.name} — Portfolio`,
    url: site.url,
    inLanguage: 'en',
    author: { '@type': 'Person', name: site.name },
  },
];
---

<Base
  title="Ahsan Tariq — Team Lead / Software Engineer at A'sTechware"
  description={site.description}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div>
          <p class="eyebrow">Software engineer and team lead · Backend and data systems</p>
          <h1>I build the data layer that makes AI features trustworthy.</h1>
          <p class="lede hero__lede">
            I am a software engineer and team lead focused on backend and data systems. My work
            includes data modelling, search and document-processing pipelines. I want to strengthen
            my foundations in data engineering and machine learning.
          </p>
          <div class="btn-row">
            <a class="btn" href="/work">Read the case studies <span class="btn__arrow">→</span></a>
            <a class="btn btn--ghost" href="/background">Background</a>
          </div>
        </div>

        <aside class="hero__aside" aria-label="At a glance">
          <img
            class="hero__photo"
            src="/ahsan-tariq.jpg"
            alt="Portrait of Ahsan Tariq"
            width="400"
            height="400"
            fetchpriority="high"
            decoding="async"
          />
          <dl class="hero__facts">
            <div class="fact">
              <dt>Now</dt>
              <dd><strong>Team lead</strong> at {site.company}; software engineer since September 2025.</dd>
            </div>
            <div class="fact">
              <dt>Based</dt>
              <dd>{site.location} · full-time, on-site</dd>
            </div>
            <div class="fact">
              <dt>Focus</dt>
              <dd>Backend and data systems: data modelling, query optimisation, search and document-processing pipelines.</dd>
            </div>
            <div class="fact">
              <dt>Stack</dt>
              <dd>Python · FastAPI · PostgreSQL · Redis · Celery · Elasticsearch · Algolia · Rails</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="container section--tight" aria-label="Summary">
    <div class="proof">
      <div class="proof__item">
        <span class="proof__value">2+ years</span>
        <span class="proof__label">Full-time at A'sTechware, Lahore</span>
      </div>
      <div class="proof__item">
        <span class="proof__value">Team lead</span>
        <span class="proof__label">Since June 2026, alongside software engineering</span>
      </div>
    </div>

    <div class="recognition">
      <p class="recognition__row">
        <span class="recognition__label mono">Education</span>
        <span>B.Sc. Computer Science, UET Lahore (Narowal Campus), CGPA 3.734 / 4.00</span>
      </p>
      <p class="recognition__row">
        <span class="recognition__label mono">Award</span>
        <span>{site.award.text}, {site.award.date}</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Selected projects</h2>
        </div>
        <p class="mono muted" style="max-width: 30ch">
          Each case study is written around a decision, not a feature list.
        </p>
      </div>

      <ul class="work-list">
        {visibleProjects.map((project) => (
          <li class="work-item">
            <a href={`/work/${project.slug}`}>
              <span class="work-item__index">{project.index}</span>
              <span>
                <span class="work-item__title">
                  {project.name}
                  {project.current && <span class="badge">Current</span>}
                </span>
                <span class="work-item__tagline">{project.tagline}</span>
              </span>
              <span class="work-item__stack">
                {project.cardStack.map((tag) => <span class="tag">{tag}</span>)}
              </span>
              <span class="work-item__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>

      <p style="margin-top: 1.6rem">
        <a href="/work">All projects, with role and scope →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">How I work</p>
          <h2>Three habits that show up in every project</h2>
        </div>
      </div>

      <div class="principles">
        <article class="principle">
          <span class="principle__n">01</span>
          <h3>Read the plan before the index</h3>
          <p>
            Most slow endpoints are a data-shape problem, not a hardware problem. A cache in front of
            a bad model makes it permanently slow and temporarily fast.
          </p>
        </article>
        <article class="principle">
          <span class="principle__n">02</span>
          <h3>Put invariants in the database</h3>
          <p>
            Application-level checks race. Constraints, locks and transactions hold when two requests
            arrive in the same millisecond — which is exactly when a booking or a payment breaks.
          </p>
        </article>
        <article class="principle">
          <span class="principle__n">03</span>
          <h3>Give probabilistic output a gate</h3>
          <p>
            Even a highly accurate model needs a way to handle its errors. That handling is part of
            the feature, not the polish.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta__grid">
      <div>
        <h2>Want to talk about data layers, search relevance, or the DEAI programme?</h2>
        <p>
          I am happy to walk through any of these systems in detail — the decisions, the trade-offs,
          and the parts I would build differently now.
        </p>
      </div>
      <div class="btn-row cta__actions">
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
        <a class="btn btn--ghost" href="/background">Background</a>
      </div>
    </div>
  </section>
</Base>
