---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <p class="footer__name">{site.name}</p>
        <p class="footer__tagline">{site.bio}</p>
      </div>
      <nav class="footer__links" aria-label="Contact">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href={site.github} rel="me noopener">GitHub</a>
        <a href={site.linkedin} rel="me noopener">LinkedIn</a>
        <a href="/work">Work</a>
        <a href={site.cv}>CV</a>
      </nav>
    </div>
    <div class="footer__bottom">
      <span>© {year} {site.name}</span>
      <span>Static site · no trackers · no cookies</span>
    </div>
  </div>
</footer>
